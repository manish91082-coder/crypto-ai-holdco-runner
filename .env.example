# Required for a live database-backed deployment.
DATABASE_URL=postgresql://holdco_pilot:REDACTED@YOUR_NEON_PILOT_HOST/crypto_holdco?sslmode=require

# Generate a long random secret in the hosting provider's secret manager.
APP_API_TOKEN=REPLACE_WITH_32_BYTE_RANDOM_SECRET

PORT=8080
WORKER_ENABLED=true
WORKER_POLL_MS=3000
WORKER_CONCURRENCY=1

# Optional free-tier model provider. Rules-only mode is the safe default.
MODEL_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Safety is locked: the pilot may prepare work but never submit, sign, trade, transfer or pay.
LIVE_SUBMISSIONS_ENABLED=false
WALLET_SIGNING_ENABLED=false
PAYMENTS_ENABLED=false